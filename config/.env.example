# Hermes Agent secrets and authorization template.
#
# Copy to ~/.hermes/.env as the dedicated `hermes` user, replace the
# placeholders locally, and chmod 0600. Never commit the deployed copy.
# An empty value means "not configured"; it is not an allow-all.
#
# Authorization is checked in this order: per-platform allow-all flag, DM
# pairing, platform allowlist, global allowlist, global allow-all, then deny.
# https://hermes-agent.nousresearch.com/docs/user-guide/security

# Model provider credential. Phase 0 picks one provider and uncomments its key.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Cross-platform allowlist: the owner's numeric platform user id. Checked after
# the per-platform allowlist and before the global allow-all, which stays off.
GATEWAY_ALLOWED_USERS=<OWNER_GATEWAY_USER_ID>

# Telegram (Phase 2). The token comes from @BotFather; the user id is numeric,
# not a @username.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=<OWNER_TELEGRAM_USER_ID>

# Never enable these. Each one grants access or weakens a control.
# GATEWAY_ALLOW_ALL_USERS=true
# TELEGRAM_ALLOW_ALL_USERS=true
# DISCORD_ALLOW_ALL_USERS=true
# WHATSAPP_ALLOW_ALL_USERS=true
# SLACK_ALLOW_ALL_USERS=true
# SIGNAL_ALLOW_ALL_USERS=true
# API_SERVER_ENABLED=true
# HERMES_YOLO_MODE=1
# SUDO_PASSWORD=
# BROWSER_CDP_URL=
